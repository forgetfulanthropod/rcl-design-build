# Email (Resend). RESEND_API_KEY is a secret: set it in the host's secret store, never commit it.
RESEND_API_KEY=
MAIL_FROM="RCL Design-Build <login@rcldesignbuild.com>"
APP_ORIGIN=https://rcl.grok.me

# SMS (Twilio). TWILIO_AUTH_TOKEN is a secret. TWILIO_FROM is an E.164 number (+18595550100) or a Messaging Service SID (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Show sign-in links on screen instead of delivering them. Local dev only: lets anyone sign in as anyone.
DEV_LINK_PREVIEW=
# Debug persona sign-in into the isolated demo company. ON unless set to false. Anyone can use it while on.
DEBUG_LOGIN=
